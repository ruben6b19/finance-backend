# Server
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Database (append the database name, e.g. mongodb://localhost:27017/financeDB)
MONGODB_URI=mongodb://localhost:27017

# Auth
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=30d

# Firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=base64-of-the-service-account-json
FIREBASE_API_KEY=your-firebase-web-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Mail (per-tenant SMTP credentials are stored encrypted in StoreConfig)
# Any passphrase works; scrypt derives a 32-byte AES key from it.
# ROTATING THIS KEY MAKES ALL STORED SMTP PASSWORDS UNREADABLE - re-save them via PUT /api/v1/store-config/mail.
MAIL_ENCRYPTION_KEY=replace-with-a-long-random-passphrase
